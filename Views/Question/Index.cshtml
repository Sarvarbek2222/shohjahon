@model IEnumerable<Question>

@{
    Layout = "_AdminLayout";
    ViewData["TitleKey"] = "qs.pageTitle";
    ViewData["Title"] = L["qs.pageTitle"];
    var totalCount = Model.Count();
}

@* <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet"> *@

<style>
    :root {
        --bg: #07080d;
        --surface: #0d0f18;
        --surface2: #131624;
        --border: rgba(255,255,255,0.07);
        --red: #ff2d4a;
        --red-dim: rgba(255,45,74,0.12);
        --gold: #f5c542;
        --text: #e8eaf0;
        --muted: #5a6080;
        --success: #00e676;
        --info: #29b6f6;
    }

    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        background: var(--bg);
        color: var(--text);
        font-family: 'DM Sans', sans-serif;
        min-height: 100vh;
    }

    /* ── PAGE WRAPPER ── */
    .qs-page {
        padding: 40px 36px 80px;
        max-width: 1400px;
        margin: 0 auto;
    }

    /* ── HEADER ── */
    .qs-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin-bottom: 48px;
        gap: 20px;
        flex-wrap: wrap;
    }

    .qs-header-left {
    }

    .qs-eyebrow {
        font-family: 'Syne', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--red);
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 10px;
    }

        .qs-eyebrow::before {
            content: '';
            width: 24px;
            height: 2px;
            background: var(--red);
            border-radius: 2px;
        }

    .qs-title {
        font-family: 'Syne', sans-serif;
        font-size: clamp(2rem, 4vw, 3.2rem);
        font-weight: 800;
        line-height: 1;
        color: #fff;
        letter-spacing: -0.02em;
    }

        .qs-title span {
            color: var(--red);
        }

    .qs-subtitle {
        margin-top: 8px;
        font-size: 0.85rem;
        color: var(--muted);
        font-weight: 300;
    }

    .btn-add {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: var(--red);
        color: #fff;
        font-family: 'Syne', sans-serif;
        font-weight: 700;
        font-size: 0.78rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 14px 28px;
        border: none;
        border-radius: 3px;
        text-decoration: none;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        transition: box-shadow 0.3s, transform 0.2s;
    }

        .btn-add::before {
            content: '';
            position: absolute;
            inset: 0;
            background: rgba(255,255,255,0.12);
            transform: translateX(-100%);
            transition: transform 0.3s ease;
        }

        .btn-add:hover::before {
            transform: translateX(0);
        }

        .btn-add:hover {
            box-shadow: 0 0 28px rgba(255,45,74,0.55);
            transform: translateY(-2px);
            color: #fff;
        }

        .btn-add svg {
            width: 18px;
            height: 18px;
        }

    /* ── STATS BAR ── */
    .qs-stats {
        display: flex;
        gap: 1px;
        background: var(--border);
        border: 1px solid var(--border);
        border-radius: 4px;
        overflow: hidden;
        margin-bottom: 32px;
    }

    .qs-stat {
        flex: 1;
        background: var(--surface);
        padding: 20px 28px;
        position: relative;
        overflow: hidden;
        transition: background 0.25s;
    }

        .qs-stat:hover {
            background: var(--surface2);
        }

        .qs-stat::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 2px;
            background: var(--red);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform 0.35s ease;
        }

        .qs-stat:hover::after {
            transform: scaleX(1);
        }

    .qs-stat-num {
        font-family: 'Syne', sans-serif;
        font-size: 2rem;
        font-weight: 800;
        color: #fff;
        line-height: 1;
    }

        .qs-stat-num span {
            color: var(--red);
        }

    .qs-stat-label {
        font-size: 0.65rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
        margin-top: 4px;
    }

    /* ── SEARCH ── */
    .qs-search {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 28px;
    }

    .search-wrap {
        position: relative;
    }

        .search-wrap svg {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            width: 16px;
            height: 16px;
            color: var(--muted);
            pointer-events: none;
        }

    .search-input {
        width: 100%;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 3px;
        color: var(--text);
        font-family: 'DM Sans', sans-serif;
        font-size: 0.88rem;
        padding: 13px 16px 13px 44px;
        outline: none;
        transition: border-color 0.25s, box-shadow 0.25s;
    }

        .search-input::placeholder {
            color: var(--muted);
        }

        .search-input:focus {
            border-color: var(--red);
            box-shadow: 0 0 0 3px rgba(255,45,74,0.12);
        }

    /* ── CARD ── */
    .qs-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 6px;
        overflow: hidden;
    }

    .qs-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 28px;
        border-bottom: 1px solid var(--border);
        flex-wrap: wrap;
        gap: 12px;
    }

    .qs-card-title {
        font-family: 'Syne', sans-serif;
        font-size: 0.9rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        color: #fff;
    }

    .qs-count-badge {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        background: var(--red-dim);
        color: var(--red);
        border: 1px solid rgba(255,45,74,0.2);
        padding: 4px 12px;
        border-radius: 2px;
    }

    /* ── TABLE ── */
    .qs-table {
        width: 100%;
        border-collapse: collapse;
    }

        .qs-table thead tr {
            background: rgba(255,255,255,0.03);
        }

        .qs-table thead th {
            font-family: 'Syne', sans-serif;
            font-size: 0.62rem;
            font-weight: 700;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: var(--muted);
            padding: 14px 20px;
            text-align: left;
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

            .qs-table thead th:last-child {
                text-align: right;
            }

        .qs-table tbody tr {
            border-bottom: 1px solid rgba(255,255,255,0.04);
            transition: background 0.2s;
            position: relative;
        }

            .qs-table tbody tr:hover {
                background: rgba(255,255,255,0.03);
            }

            .qs-table tbody tr:last-child {
                border-bottom: none;
            }

        .qs-table td {
            padding: 16px 20px;
            vertical-align: middle;
            font-size: 0.88rem;
        }

    /* ID CELL */
    .cell-id {
        font-family: 'Syne', sans-serif;
        font-weight: 700;
        font-size: 0.75rem;
        color: var(--muted);
        letter-spacing: 0.06em;
        width: 60px;
    }

    /* IMAGE CELL */
    .cell-img img {
        width: 72px;
        height: 50px;
        object-fit: cover;
        border-radius: 4px;
        border: 1px solid var(--border);
        transition: transform 0.3s, box-shadow 0.3s;
        display: block;
    }

        .cell-img img:hover {
            transform: scale(2.2);
            z-index: 10;
            position: relative;
            box-shadow: 0 12px 40px rgba(0,0,0,0.7);
        }

    /* QUESTION CELL */
    .cell-question {
        max-width: 380px;
        color: var(--text);
        font-size: 0.875rem;
        font-weight: 400;
        line-height: 1.5;
    }

    /* ANSWER CELL */
    .cell-answer {
        max-width: 240px;
    }

    .answer-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(0,230,118,0.08);
        border: 1px solid rgba(0,230,118,0.18);
        color: var(--success);
        font-size: 0.78rem;
        font-weight: 500;
        padding: 5px 12px;
        border-radius: 2px;
        line-height: 1.4;
    }

        .answer-pill::before {
            content: '';
            width: 6px;
            height: 6px;
            background: var(--success);
            border-radius: 50%;
            flex-shrink: 0;
        }

    /* ACTIONS CELL */
    .cell-actions {
        text-align: right;
        white-space: nowrap;
        width: 110px;
    }

    .btn-edit, .btn-del {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 3px;
        border: 1px solid;
        background: transparent;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
    }

    .btn-edit {
        border-color: rgba(41,182,246,0.3);
        color: var(--info);
    }

        .btn-edit:hover {
            background: rgba(41,182,246,0.12);
            border-color: var(--info);
            transform: scale(1.1);
            color: var(--info);
        }

    .btn-del {
        border-color: rgba(255,45,74,0.25);
        color: var(--red);
        margin-left: 6px;
    }

        .btn-del:hover {
            background: rgba(255,45,74,0.12);
            border-color: var(--red);
            transform: scale(1.1);
        }

        .btn-edit svg, .btn-del svg {
            width: 15px;
            height: 15px;
        }

    .qs-flash {
        margin: 0 0 18px; padding: 12px 16px; border-radius: 4px;
        border: 1px solid rgba(0,230,118,0.35); background: rgba(0,230,118,0.08); color: #7ef0b0; font-weight: 600; font-size: 0.88rem;
    }

    /* ── PAGINATION ── */
    .qs-pagination {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 28px;
        border-top: 1px solid var(--border);
        flex-wrap: wrap;
        gap: 12px;
    }

    .pagination-info {
        font-size: 0.78rem;
        color: var(--muted);
    }

        .pagination-info span {
            color: var(--text);
            font-weight: 600;
        }

    .pagination-btns {
        display: flex;
        gap: 8px;
    }

    .pg-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--surface2);
        border: 1px solid var(--border);
        color: var(--text);
        font-family: 'Syne', sans-serif;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 9px 20px;
        border-radius: 3px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .pg-btn:hover:not(:disabled) {
            border-color: var(--red);
            color: var(--red);
            background: var(--red-dim);
        }

        .pg-btn:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }

        .pg-btn svg {
            width: 14px;
            height: 14px;
        }

    /* ── EMPTY STATE ── */
    .qs-empty {
        text-align: center;
        padding: 80px 20px;
        color: var(--muted);
    }

    .qs-empty-icon {
        font-size: 3rem;
        margin-bottom: 16px;
        opacity: 0.4;
    }

    .qs-empty-text {
        font-size: 0.9rem;
    }

    /* ── RESPONSIVE ── */
    @@media (max-width: 900px) {
        .qs-page {
            padding: 24px 16px 60px;
        }

        .qs-search {
            grid-template-columns: 1fr;
        }

        .qs-stats {
            flex-wrap: wrap;
        }

        .qs-stat {
            flex: 1 1 45%;
        }

        .cell-question {
            max-width: 200px;
            font-size: 0.8rem;
        }

        .cell-answer {
            display: none;
        }
    }

    @@media (max-width: 600px) {
        .qs-table thead th:nth-child(2) {
            display: none;
        }

        .qs-table td:nth-child(2) {
            display: none;
        }

        .qs-title {
            font-size: 1.8rem;
        }
    }

    .cell-langs { white-space: nowrap; }
    .lang-pill {
        display: inline-block;
        font-size: 0.66rem;
        font-weight: 700;
        padding: 2px 6px;
        margin-right: 3px;
        border-radius: 3px;
        letter-spacing: 0.04em;
    }
    .lang-pill.ok { background: rgba(0,230,118,0.12); color: #00e676; border: 1px solid rgba(0,230,118,0.3); }
    .lang-pill.missing { background: rgba(255,255,255,0.04); color: #5a6080; border: 1px dashed rgba(255,255,255,0.15); text-decoration: line-through; }
</style>

<div class="qs-page">

    <!-- HEADER -->
    <div class="qs-header">
        <div class="qs-header-left">
            <div class="qs-eyebrow" data-i18n="admin.panel">@L["admin.panel"]</div>
            <h1 class="qs-title" data-i18n-html="qs.title">@L.Html("qs.title")</h1>
            <p class="qs-subtitle" data-i18n="qs.subtitle">@L["qs.subtitle"]</p>
        </div>
        <a asp-action="Create" class="btn-add">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
            <span data-i18n="qs.new">@L["qs.new"]</span>
        </a>
    </div>

    <!-- STATS -->
    @if (TempData["QsMsgKey"] is string qsMsg)
    {
        <div class="qs-flash" role="status" data-i18n="@qsMsg">@L[qsMsg]</div>
    }

    <div class="qs-stats">
        <div class="qs-stat">
            <div class="qs-stat-num"><span>@totalCount</span></div>
            <div class="qs-stat-label" data-i18n="qs.total">@L["qs.total"]</div>
        </div>
        <div class="qs-stat">
            <div class="qs-stat-num" id="visibleCount"><span>@totalCount</span></div>
            <div class="qs-stat-label" data-i18n="qs.showing">@L["qs.showing"]</div>
        </div>
        <div class="qs-stat">
            <div class="qs-stat-num"><span>@Model.Count(q => q.Options.Any(o => o.IsCorrect))</span></div>
            <div class="qs-stat-label" data-i18n="qs.withAnswer">@L["qs.withAnswer"]</div>
        </div>
        <div class="qs-stat">
            <div class="qs-stat-num"><span>@Model.Count(q => !string.IsNullOrEmpty(q.ImageUrl))</span></div>
            <div class="qs-stat-label" data-i18n="qs.withImage">@L["qs.withImage"]</div>
        </div>
    </div>

    <!-- SEARCH -->
    <div class="qs-search">
        <div class="search-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
            <input type="text" id="searchQuestion" class="search-input" placeholder="@L["qs.searchText"]" data-i18n-placeholder="qs.searchText">
        </div>
        <div class="search-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <line x1="3" y1="9" x2="21" y2="9" />
                <line x1="9" y1="21" x2="9" y2="9" />
            </svg>
            <input type="text" id="searchId" class="search-input" placeholder="@L["qs.searchId"]" data-i18n-placeholder="qs.searchId">
        </div>
    </div>

    <!-- MAIN CARD -->
    <div class="qs-card">
        <div class="qs-card-header">
            <div class="qs-card-title" data-i18n="qs.list">@L["qs.list"]</div>
            <div class="qs-count-badge" data-i18n="qs.totalBadge" data-i18n-args='{"n":@totalCount}'>@L.F("qs.totalBadge", ("n", totalCount))</div>
        </div>

        <div style="overflow-x:auto;">
            <table class="qs-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th data-i18n="qs.colImage">@L["qs.colImage"]</th>
                        <th data-i18n="qs.colText">@L["qs.colText"]</th>
                        <th data-i18n="qs.colCorrect">@L["qs.colCorrect"]</th>
                        <th data-i18n="qs.colLangs">@L["qs.colLangs"]</th>
                        <th style="text-align:right;" data-i18n="qs.colActions">@L["qs.colActions"]</th>
                    </tr>
                </thead>
                <tbody id="questionTable">
                    @foreach (var q in Model)
                    {
                        var correct = q.Options.FirstOrDefault(x => x.IsCorrect);
                        var hasRu = !string.IsNullOrWhiteSpace(q.QuestionRU);
                        var hasUzk = !string.IsNullOrWhiteSpace(q.QuestionUZK);
                        <tr class="question-row" data-search="@(q.QuestionUZ) @(q.QuestionRU) @(q.QuestionUZK)">
                            <td class="cell-id">@q.Id</td>
                            <td class="cell-img">
                                <img loading="lazy" decoding="async" src="@(string.IsNullOrEmpty(q.ImageUrl) ? "/images/avprsm.png?w=160" : "/uploads/" + q.ImageUrl + "?w=160")"
                                     alt="@L["test.imageAlt"]" data-i18n-alt="test.imageAlt" />
                            </td>
                            <td class="cell-question" data-i18n-pick data-uz="@q.QuestionUZ" data-ru="@q.QuestionRU" data-uzk="@q.QuestionUZK">@L.Pick(q.QuestionUZ, q.QuestionRU, q.QuestionUZK)</td>
                            <td class="cell-answer">
                                @if (correct != null)
                                {
                                    <span class="answer-pill" data-i18n-pick data-uz="@correct.OptionUZ" data-ru="@correct.OptionRU" data-uzk="@correct.OptionUZK">@L.Pick(correct.OptionUZ, correct.OptionRU, correct.OptionUZK)</span>
                                }
                                else
                                {
                                    <span style="color:var(--muted); font-size:0.78rem;">—</span>
                                }
                            </td>
                            <td class="cell-langs">
                                <span class="lang-pill ok" title="@L["form.langUz"]" data-i18n-title="form.langUz">@L["lang.uz"]</span>
                                <span class="lang-pill @(hasRu ? "ok" : "missing")" title="@(hasRu ? L["form.langRu"] : L["qs.missing"])">@L["lang.ru"]</span>
                                <span class="lang-pill @(hasUzk ? "ok" : "missing")" title="@(hasUzk ? L["form.langUzk"] : L["qs.missing"])">@L["lang.uzk"]</span>
                            </td>
                            <td class="cell-actions">
                                <a asp-action="Edit" asp-route-id="@q.Id" class="btn-edit" title="@L["qs.edit"]" data-i18n-title="qs.edit">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
                                    </svg>
                                </a>
                                @* O'chirish — avval tasdiqlash sahifasi (savol to'liq ko'rsatiladi) *@
                                <a asp-action="Delete" asp-route-id="@q.Id" class="btn-del" title="@L["qs.delete"]" data-i18n-title="qs.delete">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="3 6 5 6 21 6" />
                                        <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
                                        <path d="M10 11v6M14 11v6" />
                                        <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                                    </svg>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div id="emptyState" class="qs-empty" style="display:none;">
                <div class="qs-empty-icon">🔍</div>
                <div class="qs-empty-text" data-i18n="qs.empty">@L["qs.empty"]</div>
            </div>
        </div>

        <!-- PAGINATION -->
        <div class="qs-pagination">
            <div class="pagination-info">
                <span data-i18n="qs.pageInfo">@L["qs.pageInfo"]</span> <span id="pageInfo">1 – 20</span>
            </div>
            <div class="pagination-btns">
                <button class="pg-btn" id="prevBtn" disabled>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="15 18 9 12 15 6" />
                    </svg>
                    <span data-i18n="qs.prev">@L["qs.prev"]</span>
                </button>
                <button class="pg-btn" id="nextBtn">
                    <span data-i18n="qs.next">@L["qs.next"]</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="9 18 15 12 9 6" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

</div>

<script>
    const PER_PAGE = 20;
    let currentPage = 1;
    let filteredRows = [];

    const allRows = () => Array.from(document.querySelectorAll("#questionTable tr.question-row"));

    function applyFilters() {
        const qVal = document.getElementById("searchQuestion").value.toLowerCase().trim();
        const idVal = document.getElementById("searchId").value.trim();

        filteredRows = allRows().filter(row => {
            const text = (row.dataset.search || "").toLowerCase();
            const id   = row.querySelector(".cell-id")?.innerText.trim() || "";
            const matchQ  = qVal === "" || text.includes(qVal);
            const matchId = idVal === "" || id.includes(idVal);
            return matchQ && matchId;
        });

        currentPage = 1;
        renderPage();
    }

    function renderPage() {
        const total = filteredRows.length;
        const start = (currentPage - 1) * PER_PAGE;
        const end   = Math.min(start + PER_PAGE, total);

        allRows().forEach(r => r.style.display = "none");
        filteredRows.forEach((r, i) => {
            r.style.display = (i >= start && i < end) ? "" : "none";
        });

        // empty state
        document.getElementById("emptyState").style.display = total === 0 ? "block" : "none";

        // pagination info
        document.getElementById("pageInfo").textContent =
            total === 0 ? "0" : `${start + 1} – ${end} / ${total}`;

        // visible count stat
        document.querySelector("#visibleCount span").textContent = total;

        // buttons
        document.getElementById("prevBtn").disabled = currentPage <= 1;
        document.getElementById("nextBtn").disabled = end >= total;
    }

    document.getElementById("searchQuestion").addEventListener("input", applyFilters);
    document.getElementById("searchId").addEventListener("input", applyFilters);

    document.getElementById("prevBtn").addEventListener("click", () => {
        if (currentPage > 1) { currentPage--; renderPage(); }
    });
    document.getElementById("nextBtn").addEventListener("click", () => {
        currentPage++; renderPage();
    });

    // init
    applyFilters();
</script>
