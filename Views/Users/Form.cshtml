@model UserForm
@{
    Layout = "_AdminLayout";
    var titleKey = Model.IsNew ? "users.createTitle" : "users.editTitle";
    ViewData["TitleKey"] = titleKey;
    ViewData["Title"] = L[titleKey];

    string? FieldError(string name) =>
        ViewData.ModelState.TryGetValue(name, out var e) && e.Errors.Count > 0 ? e.Errors[0].ErrorMessage : null;

    var generalErrors = ViewData.ModelState.TryGetValue("", out var g) ? g.Errors.Select(x => x.ErrorMessage).ToList() : new List<string>();
}

<partial name="_UsersStyles" />

<div class="us-page">
    <div class="us-header">
        <div>
            <div class="us-eyebrow" data-i18n="admin.panel">@L["admin.panel"]</div>
            <h1 class="us-title" data-i18n="@titleKey">@L[titleKey]</h1>
        </div>
    </div>

    @if (TempData["MsgKey"] is string msgKey)
    {
        <div class="us-alert ok" role="status" data-i18n="@msgKey">@L[msgKey]</div>
    }

    @foreach (var err in generalErrors)
    {
        <div class="us-alert err" role="alert">⚠ @err</div>
    }

    <form asp-action="@(Model.IsNew ? "Create" : "Edit")" method="post" class="us-form" autocomplete="off">
        <input type="hidden" asp-for="Id" />

        <div class="us-grid-2">
            <div class="us-field">
                <label class="us-label" for="Username" data-i18n="users.username">@L["users.username"]</label>
                <input asp-for="Username" class="us-input @(FieldError("Username") != null ? "invalid" : "")"
                       required maxlength="64" autocomplete="off" />
                @if (FieldError("Username") is string ue)
                {
                    <span class="us-field-err">@ue</span>
                }
                else
                {
                    <span class="us-hint" data-i18n="users.usernameHint">@L["users.usernameHint"]</span>
                }
            </div>

            <div class="us-field">
                <label class="us-label" for="FullName" data-i18n="users.fullName">@L["users.fullName"]</label>
                <input asp-for="FullName" class="us-input" maxlength="128" />
            </div>
        </div>

        <div class="us-field">
            @{
                // Saqlangan raqamdan "+998" dan keyingi 9 ta raqam (90 123 45 67)
                var phoneDigits = new string((Model.Phone ?? "").Where(char.IsDigit).ToArray());
                if (phoneDigits.Length == 12 && phoneDigits.StartsWith("998")) { phoneDigits = phoneDigits[3..]; }
                var phoneLocal = phoneDigits.Length == 9
                    ? $"{phoneDigits[..2]} {phoneDigits[2..5]} {phoneDigits[5..7]} {phoneDigits[7..]}"
                    : phoneDigits;
            }
            <label class="us-label" for="PhoneLocal" data-i18n="users.phone">@L["users.phone"]</label>
            <div class="us-phone-field @(FieldError("Phone") != null ? "invalid" : "")">
                <span class="us-phone-cc" aria-hidden="true">+998</span>
                <input id="PhoneLocal" type="tel" inputmode="numeric" class="us-input" maxlength="12" autocomplete="off"
                       placeholder="90 123 45 67" value="@phoneLocal" aria-describedby="phoneHelp" />
                <input type="hidden" asp-for="Phone" />
            </div>
            @if (FieldError("Phone") is string phe)
            {
                <span class="us-field-err">@phe</span>
            }
            else
            {
                <span class="us-hint" id="phoneHelp" data-i18n="users.phoneHint2">@L["users.phoneHint2"]</span>
            }
        </div>

        <div class="us-field">
            <label class="us-label" for="Role" data-i18n="users.role">@L["users.role"]</label>
            <select asp-for="Role" class="us-input">
                @foreach (var r in Roles.All)
                {
                    var key = "role." + r;
                    <option value="@r" data-i18n="@key">@L[key]</option>
                }
            </select>
            <span class="us-hint" data-i18n="users.roleHint">@L["users.roleHint"]</span>
        </div>

        @* Hisob turi: shaxsiy o'quvchi yoki o'quv markazidagi kompyuter (super admin uchun yashirin) *@
        <div class="us-field" id="kindSection">
            <span class="us-label" data-i18n="users.kind">@L["users.kind"]</span>
            <div class="us-kind" role="radiogroup">
                <label class="us-kind-opt">
                    <input type="radio" name="IsComputer" value="false" @(Model.IsComputer ? "" : "checked") />
                    <span class="us-kind-ic">@Icons.User</span>
                    <span>
                        <b data-i18n="users.kindStudent">@L["users.kindStudent"]</b>
                        <small data-i18n="users.kindStudentHint">@L["users.kindStudentHint"]</small>
                    </span>
                </label>
                <label class="us-kind-opt">
                    <input type="radio" name="IsComputer" value="true" @(Model.IsComputer ? "checked" : "") />
                    <span class="us-kind-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4" /></svg></span>
                    <span>
                        <b data-i18n="users.kindComputer">@L["users.kindComputer"]</b>
                        <small data-i18n="users.kindComputerHint">@L["users.kindComputerHint"]</small>
                    </span>
                </label>
            </div>
        </div>

        <div class="us-grid-2">
            <div class="us-field">
                <label class="us-label" for="Password" data-i18n="@(Model.IsNew ? "users.password" : "users.newPassword")">@L[Model.IsNew ? "users.password" : "users.newPassword"]</label>
                <div class="us-pwd">
                    <input asp-for="Password" type="password" class="us-input @(FieldError("Password") != null ? "invalid" : "")"
                           autocomplete="new-password" />
                    <button type="button" class="us-eye" data-pwd-toggle aria-pressed="false" title="@L["users.showPassword"]" data-i18n-title="users.showPassword" aria-label="@L["users.showPassword"]">@Icons.Eye</button>
                </div>
                @if (FieldError("Password") is string pe)
                {
                    <span class="us-field-err">@pe</span>
                }
                else
                {
                    <span class="us-hint" data-i18n="@(Model.IsNew ? "users.passwordHint" : "users.keepPassword")">@L[Model.IsNew ? "users.passwordHint" : "users.keepPassword"]</span>
                }
            </div>

            <div class="us-field">
                <label class="us-label" for="ConfirmPassword" data-i18n="users.confirmPassword">@L["users.confirmPassword"]</label>
                <div class="us-pwd">
                    <input asp-for="ConfirmPassword" type="password" class="us-input @(FieldError("ConfirmPassword") != null ? "invalid" : "")"
                           autocomplete="new-password" />
                    <button type="button" class="us-eye" data-pwd-toggle aria-pressed="false" title="@L["users.showPassword"]" data-i18n-title="users.showPassword" aria-label="@L["users.showPassword"]">@Icons.Eye</button>
                </div>
                @if (FieldError("ConfirmPassword") is string ce)
                {
                    <span class="us-field-err">@ce</span>
                }
            </div>
        </div>

        <label class="us-check">
            <input asp-for="IsActive" type="checkbox" />
            <span data-i18n="users.isActive">@L["users.isActive"]</span>
        </label>

        @* ⏳ Kirish muddati: 1 kundan 12 oygacha yoki cheksiz. Super admin uchun qo'llanmaydi. *@
        <fieldset class="us-section" id="accessSection">
            <legend class="us-label" data-i18n="users.access">@L["users.access"]</legend>

            @if (!Model.IsNew)
            {
                var now = DateTime.UtcNow;
                <div class="us-current">
                    <span data-i18n="users.currentAccess">@L["users.currentAccess"]</span>:
                    @if (Model.CurrentExpiresAt == null)
                    {
                        <b class="us-pill inf">∞ <span data-i18n="users.unlimited">@L["users.unlimited"]</span></b>
                    }
                    else if (Model.CurrentExpiresAt <= now)
                    {
                        <b class="us-pill exp" data-i18n="users.expired">@L["users.expired"]</b>
                        <span class="us-muted">@L.Stamp(Model.CurrentExpiresAt.Value)</span>
                    }
                    else
                    {
                        var left = (int)Math.Ceiling((Model.CurrentExpiresAt.Value - now).TotalDays);
                        <b>@L.Stamp(Model.CurrentExpiresAt.Value)</b>
                        <span class="us-left @(left <= 7 ? "warn" : "")" data-i18n="users.daysLeft" data-i18n-args='{"n":@left}'>@L.F("users.daysLeft", ("n", left))</span>
                    }
                </div>
            }

            <input type="hidden" asp-for="AccessMode" id="accessMode" />
            <div class="us-seg" role="group">
                @if (!Model.IsNew)
                {
                    <button type="button" class="us-seg-btn" data-mode="keep" data-i18n="users.accessKeep">@L["users.accessKeep"]</button>
                }
                <button type="button" class="us-seg-btn" data-mode="set" data-i18n="users.accessSet">@L["users.accessSet"]</button>
                <button type="button" class="us-seg-btn inf" data-mode="unlimited">∞ <span data-i18n="users.unlimited">@L["users.unlimited"]</span></button>
            </div>

            <div class="us-set" id="accessSet">
                <div class="us-chips">
                    @foreach (var (n, unit) in new[] { (1, "d"), (3, "d"), (7, "d"), (15, "d"), (1, "m"), (2, "m"), (3, "m"), (6, "m"), (12, "m") })
                    {
                        var key = unit == "d" ? "users.nDays" : "users.nMonths";
                        <button type="button" class="us-chip" data-amount="@n" data-unit="@unit"
                                data-i18n="@key" data-i18n-args='{"n":@n}'>@L.F(key, ("n", n))</button>
                    }
                </div>
                <div class="us-amount">
                    <input asp-for="AccessAmount" type="number" min="1" max="365" step="1" id="accessAmount"
                           class="us-input @(FieldError("AccessAmount") != null ? "invalid" : "")" inputmode="numeric" />
                    <select asp-for="AccessUnit" id="accessUnit" class="us-input">
                        <option value="d" data-i18n="users.unitDays">@L["users.unitDays"]</option>
                        <option value="m" data-i18n="users.unitMonths">@L["users.unitMonths"]</option>
                    </select>
                    <span class="us-until" id="accessUntil"></span>
                </div>
                @if (FieldError("AccessAmount") is string ae)
                {
                    <span class="us-field-err">@ae</span>
                }
                else
                {
                    <span class="us-hint" data-i18n="users.accessHint">@L["users.accessHint"]</span>
                }
            </div>
            <p class="us-hint" id="accessUnlimitedHint" data-i18n="users.unlimitedHint">@L["users.unlimitedHint"]</p>
        </fieldset>
        <p class="us-hint us-admin-note" id="adminNote" data-i18n="users.adminNoLimits">@L["users.adminNoLimits"]</p>

        @if (!Model.IsNew)
        {
            @* 📱 Bitta qurilma: bog'langan qurilma va uni bo'shatish *@
            <fieldset class="us-section" id="deviceSection">
                <legend class="us-label" data-i18n="users.device">@L["users.device"]</legend>
                <div class="us-device-row">
                    <div>
                        @if (Model.HasDevice)
                        {
                            <div class="us-device">@Model.DeviceInfo</div>
                            @if (Model.DeviceBoundAt is DateTime db)
                            {
                                <div class="us-muted"><span data-i18n="users.boundAt">@L["users.boundAt"]</span>: @L.Stamp(db)</div>
                            }
                        }
                        else
                        {
                            <div class="us-muted" data-i18n="users.noDeviceLong">@L["users.noDeviceLong"]</div>
                        }
                        @if (Model.PendingRequests > 0)
                        {
                            <a asp-action="Devices" class="us-pill pend" data-i18n="users.pendingDevice">@L["users.pendingDevice"]</a>
                        }
                    </div>
                    @if (Model.HasDevice)
                    {
                        <button type="submit" form="resetDeviceForm" class="us-btn us-btn-ghost us-btn-sm"
                                onclick="return confirm(I18n.t('users.resetDeviceConfirm'))" data-i18n="users.resetDevice">@L["users.resetDevice"]</button>
                    }
                </div>
                @if (SiteSettings.SingleDevice || Model.IsComputer)
                {
                    <p class="us-hint" data-i18n="users.deviceHint">@L["users.deviceHint"]</p>
                }
                else
                {
                    <p class="us-hint" data-i18n="users.deviceRuleOff">@L["users.deviceRuleOff"]</p>
                }
            </fieldset>
        }

        <div class="us-form-actions">
            <a asp-action="Index" class="us-btn us-btn-ghost" data-i18n="form.back">@L["form.back"]</a>
            <button type="submit" class="us-btn us-btn-primary" data-i18n="users.save">@L["users.save"]</button>
        </div>
    </form>

    @if (!Model.IsNew)
    {
        <form asp-action="ResetDevice" asp-route-id="@Model.Id" method="post" id="resetDeviceForm" hidden></form>
    }
</div>

<script>
    (function () {
        var mode = document.getElementById("accessMode");
        var setBox = document.getElementById("accessSet");
        var unlimitedHint = document.getElementById("accessUnlimitedHint");
        var amount = document.getElementById("accessAmount");
        var unit = document.getElementById("accessUnit");
        var until = document.getElementById("accessUntil");
        var role = document.getElementById("Role");
        var segs = document.querySelectorAll(".us-seg-btn");
        var chips = document.querySelectorAll(".us-chip");

        function pad(n) { return (n < 10 ? "0" : "") + n; }

        function refresh() {
            var m = mode.value || "unlimited";
            segs.forEach(function (b) { b.classList.toggle("on", b.dataset.mode === m); });
            setBox.hidden = m !== "set";
            unlimitedHint.hidden = m !== "unlimited";

            var n = parseInt(amount.value, 10), u = unit.value;
            amount.max = u === "m" ? 12 : 365;
            chips.forEach(function (c) { c.classList.toggle("on", +c.dataset.amount === n && c.dataset.unit === u); });

            var ok = n >= 1 && n <= +amount.max;
            amount.classList.toggle("invalid", m === "set" && !ok);
            if (m === "set" && ok) {
                var d = new Date();
                if (u === "m") d.setMonth(d.getMonth() + n); else d.setDate(d.getDate() + n);
                var s = pad(d.getDate()) + "." + pad(d.getMonth() + 1) + "." + d.getFullYear() + " " + pad(d.getHours()) + ":" + pad(d.getMinutes());
                until.setAttribute("data-i18n-args", JSON.stringify({ date: s }));
                until.setAttribute("data-i18n", "users.until");
                until.textContent = I18n.t("users.until", { date: s });
            } else {
                until.removeAttribute("data-i18n");
                until.textContent = "";
            }
        }

        // Super admin uchun muddat va qurilma cheklovi yo'q — bo'limlar yashiriladi
        // 👁 Parolni ko'rsatish / yashirish
        var eyeOn = @Json.Serialize(Icons.Eye.ToString()), eyeOff = @Json.Serialize(Icons.EyeOff.ToString());
        var eyeBtns = document.querySelectorAll("[data-pwd-toggle]");
        eyeBtns.forEach(function (btn) {
            btn.addEventListener("click", function () {
                var show = btn.parentNode.querySelector("input").type === "password";
                var key = show ? "users.hidePassword" : "users.showPassword";
                eyeBtns.forEach(function (b) {
                    b.parentNode.querySelector("input").type = show ? "text" : "password";
                    b.innerHTML = show ? eyeOff : eyeOn;
                    b.setAttribute("aria-pressed", show ? "true" : "false");
                    b.title = I18n.t(key);
                    b.setAttribute("aria-label", I18n.t(key));
                    b.setAttribute("data-i18n-title", key);
                });
                btn.parentNode.querySelector("input").focus();
            });
        });

        // 📞 Telefon: faqat raqamlar, "90 123 45 67" ko'rinishida; yashirin maydonga "+998901234567" yoziladi
        var phoneLocal = document.getElementById("PhoneLocal"), phoneHidden = document.getElementById("Phone");
        function syncPhone() {
            var d = phoneLocal.value.replace(/\D/g, "");
            if (d.length > 9 && d.indexOf("998") === 0) d = d.slice(3); // "+998..." to'liq yopishtirilsa
            d = d.slice(0, 9);
            var parts = [d.slice(0, 2), d.slice(2, 5), d.slice(5, 7), d.slice(7, 9)].filter(Boolean);
            phoneLocal.value = parts.join(" ");
            phoneHidden.value = d ? "+998" + d : "";
        }
        phoneLocal.addEventListener("input", syncPhone);
        syncPhone();

        function refreshRole() {
            var admin = role.value === "superadmin";
            document.getElementById("kindSection").hidden = admin;
            document.getElementById("accessSection").hidden = admin;
            document.getElementById("adminNote").hidden = !admin;
            var dev = document.getElementById("deviceSection");
            if (dev) dev.hidden = admin;
        }

        segs.forEach(function (b) { b.addEventListener("click", function () { mode.value = b.dataset.mode; refresh(); }); });
        chips.forEach(function (c) {
            c.addEventListener("click", function () {
                mode.value = "set"; amount.value = c.dataset.amount; unit.value = c.dataset.unit; refresh();
            });
        });
        amount.addEventListener("input", refresh);
        unit.addEventListener("change", function () {
            if (unit.value === "m" && +amount.value > 12) amount.value = 12;
            refresh();
        });
        role.addEventListener("change", refreshRole);
        refresh();
        refreshRole();
    })();
</script>
