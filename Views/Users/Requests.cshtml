@model List<RegistrationRequest>
@* Saytdan kelgan ro'yxatdan o'tish arizalari — admin login beradi yoki rad etadi *@
@{
    Layout = "_AdminLayout";
    ViewData["TitleKey"] = "reg.adminTitle";
    ViewData["Title"] = L["reg.adminTitle"];
    var msgKey = TempData["MsgKey"] as string;
    var pending = Model.Count(r => r.Status == "pending");
}
<div class="ca-body-embed">
    <div class="ca-page-head">
        <div>
            <div class="ca-eyebrow" data-i18n="admin.panel">@L["admin.panel"]</div>
            <h1 class="ca-h1" data-i18n="reg.adminTitle">@L["reg.adminTitle"]</h1>
            <p class="ca-sub" data-i18n="reg.adminSub">@L["reg.adminSub"]</p>
        </div>
        <span class="lg-chip @(pending > 0 ? "lg-shame" : "lg-good")" style="font-size:14px;">@pending <span data-i18n="reg.pendingN">@L["reg.pendingN"]</span></span>
    </div>
    @if (msgKey != null) { <div class="ca-alert ca-alert-info" data-i18n="@msgKey">@L[msgKey]</div> }
    @if (Model.Count == 0)
    {
        <div class="ca-card ca-empty"><div class="ca-empty-icon">📝</div><p data-i18n="reg.none">@L["reg.none"]</p></div>
    }
    <div class="rq-list">
        @foreach (var r in Model)
        {
            var sk = "reg.st_" + r.Status;
            <article class="ca-card rq @(r.Status)">
                <div class="rq-main">
                    <b>@r.FullName</b>
                    <a class="ca-link" href="tel:@r.Phone">@UserService.FormatPhone(r.Phone)</a>
                    @if (r.Username != null) { <span class="ca-muted">@@@r.Username</span> }
                    @if (r.Note != null) { <p class="rq-note">@r.Note</p> }
                    <small class="ca-muted">@L.Stamp(r.CreatedAt)</small>
                </div>
                <div class="rq-side">
                    <span class="bl-st bl-@(r.Status == "pending" ? "pending" : r.Status == "approved" ? "paid" : "cancelled")" data-i18n="@sk">@L[sk]</span>
                    @if (r.Status == "pending")
                    {
                        <a class="ca-btn ca-btn-primary ca-btn-sm" href="/Users/Create?req=@r.Id">🔑 <span data-i18n="reg.giveLogin">@L["reg.giveLogin"]</span></a>
                        <form method="post" action="/Users/RejectRequest/@r.Id" onsubmit="return confirm(I18n.t('reg.rejectConfirm'))">
                            @Html.AntiForgeryToken()
                            <button class="ca-btn ca-btn-ghost ca-btn-sm" type="submit" data-i18n="reg.reject">@L["reg.reject"]</button>
                        </form>
                    }
                    else if (r.UserId is int uid)
                    {
                        <a class="ca-link" href="/Users/Edit/@uid" data-i18n="reg.openUser">@L["reg.openUser"]</a>
                    }
                </div>
            </article>
        }
    </div>
</div>
<style>
    .rq-list { display: grid; gap: 10px; }
    .rq { display: flex; justify-content: space-between; gap: 14px; align-items: center; flex-wrap: wrap; }
    .rq.pending { border-color: rgba(245,165,36,.45); }
    .rq.rejected, .rq.approved { opacity: .65; }
    .rq-main { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: baseline; min-width: 0; flex: 1; }
    .rq-main b { font-size: 15.5px; }
    .rq-note { flex-basis: 100%; margin: 4px 0; color: #cfd3e0; font-size: 14px; overflow-wrap: anywhere; }
    .rq-side { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .bl-st { padding: 2px 9px; border-radius: 999px; font-size: 12px; font-weight: 700; }
    .bl-paid { color: var(--ca-ok); background: var(--ca-ok-soft); }
    .bl-pending { color: var(--ca-warn); background: var(--ca-warn-soft); }
    .bl-cancelled { color: var(--ca-muted); background: rgba(255,255,255,.06); }
</style>
