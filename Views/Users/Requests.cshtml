@model List<RegistrationRequest>
@* Saytdan kelgan ro'yxatdan o'tish arizalari — admin login beradi yoki rad etadi *@
@{
    Layout = "_AdminLayout";
    ViewData["TitleKey"] = "reg.adminTitle";
    ViewData["Title"] = L["reg.adminTitle"];
    var msgKey = TempData["MsgKey"] as string;
    var errKey = TempData["ErrKey"] as string;
    var msgN = TempData["MsgN"] as int?;
    var rejectedN = Model.Count(r => r.Status == "rejected");
    var pending = Model.Count(r => r.Status == "pending");
}
<div class="ca-body-embed">
    <div class="ca-page-head">
        <div>
            <div class="ca-eyebrow" data-i18n="admin.panel">@L["admin.panel"]</div>
            <h1 class="ca-h1" data-i18n="reg.adminTitle">@L["reg.adminTitle"]</h1>
            <p class="ca-sub" data-i18n="reg.adminSub">@L["reg.adminSub"]</p>
        </div>
        <span class="lg-chip @(pending > 0 ? "lg-shame" : "lg-good")" style="font-size:14px;">@pending <span data-i18n="reg.pendingN">@L["reg.pendingN"]</span></span>
    </div>
    @if (msgKey != null) { <div class="ca-alert ca-alert-info" data-i18n="@msgKey" data-i18n-args='{"n":@(msgN ?? 0)}'>@L.F(msgKey, ("n", msgN ?? 0))</div> }
    @if (errKey != null) { <div class="ca-alert" style="border-color:rgba(255,77,106,.5);color:#ffb3c0;" data-i18n="@errKey">@L[errKey]</div> }
    @if (Model.Count > 0)
    {
        <form method="post" action="/Users/DeleteRequests" id="rqBulk" class="rq-bar">
            @Html.AntiForgeryToken()
            <label class="rq-all"><input type="checkbox" id="rqAll" /> <span data-i18n="users.selectAll">@L["users.selectAll"]</span></label>
            <span class="ca-muted ca-small"><b id="rqN">0</b> <span data-i18n="users.selected">@L["users.selected"]</span></span>
            <span style="flex:1"></span>
            <button type="submit" class="ca-btn ca-btn-ghost ca-btn-sm" id="rqDelSel" disabled onclick="return confirm(I18n.t('reg.delSelConfirm'))">🗑 <span data-i18n="users.deleteSelected">@L["users.deleteSelected"]</span></button>
            @if (rejectedN > 0)
            {
                <button type="submit" name="scope" value="rejected" class="ca-btn ca-btn-ghost ca-btn-sm" onclick="return confirm(I18n.t('reg.delRejectedConfirm'))">✕ <span data-i18n="reg.delRejected" data-i18n-args='{"n":@rejectedN}'>@L.F("reg.delRejected", ("n", rejectedN))</span></button>
            }
            <button type="submit" name="scope" value="all" class="ca-btn ca-btn-sm rq-danger" onclick="return confirm(I18n.t('reg.delAllConfirm'))">🗑 <span data-i18n="reg.delAll">@L["reg.delAll"]</span></button>
        </form>
    }
    @if (Model.Count == 0)
    {
        <div class="ca-card ca-empty"><div class="ca-empty-icon">📝</div><p data-i18n="reg.none">@L["reg.none"]</p></div>
    }
    <div class="rq-list">
        @foreach (var r in Model)
        {
            var sk = "reg.st_" + r.Status;
            <article class="ca-card rq @(r.Status)">
                <input type="checkbox" class="rq-chk" name="ids" value="@r.Id" form="rqBulk" aria-label="@r.FullName" />
                <div class="rq-main">
                    <b>@r.FullName</b>
                    <a class="ca-link" href="tel:@r.Phone">@UserService.FormatPhone(r.Phone)</a>
                    @if (r.Username != null) { <span class="ca-muted">@@@r.Username</span> }
                    @if (r.Note != null) { <p class="rq-note">@r.Note</p> }
                    <small class="ca-muted">@L.Stamp(r.CreatedAt)</small>
                </div>
                <div class="rq-side">
                    <span class="bl-st bl-@(r.Status == "pending" ? "pending" : r.Status == "approved" ? "paid" : "cancelled")" data-i18n="@sk">@L[sk]</span>
                    @if (r.Status == "pending")
                    {
                        <a class="ca-btn ca-btn-primary ca-btn-sm" href="/Users/Create?req=@r.Id">🔑 <span data-i18n="reg.giveLogin">@L["reg.giveLogin"]</span></a>
                        <form method="post" action="/Users/RejectRequest/@r.Id" onsubmit="return confirm(I18n.t('reg.rejectConfirm'))">
                            @Html.AntiForgeryToken()
                            <button class="ca-btn ca-btn-ghost ca-btn-sm" type="submit" data-i18n="reg.reject">@L["reg.reject"]</button>
                        </form>
                    }
                    else if (r.UserId is int uid)
                    {
                        <a class="ca-link" href="/Users/Edit/@uid" data-i18n="reg.openUser">@L["reg.openUser"]</a>
                    }
                    @if (r.Status != "pending")
                    {
                        <form method="post" action="/Users/DeleteRequests" onsubmit="return confirm(I18n.t('reg.delOneConfirm'))">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ids" value="@r.Id" />
                            <button type="submit" class="ca-btn ca-btn-ghost ca-btn-sm rq-del" title="@L["ls.delete"]">🗑</button>
                        </form>
                    }
                </div>
            </article>
        }
    </div>
</div>
<style>
    .rq-list { display: grid; gap: 10px; }
    .rq-bar { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 12px; padding: 10px 14px; border-radius: 14px; background: var(--ca-surface); border: 1px solid var(--ca-border); position: sticky; top: 70px; z-index: 5; }
    .rq-all { display: inline-flex; gap: 6px; align-items: center; font-size: 13px; cursor: pointer; }
    .rq-chk, .rq-all input { width: 18px; height: 18px; accent-color: #ff2d4a; flex: 0 0 auto; }
    .rq-danger { background: #ef4444; color: #fff; border: 0; }
    .rq-del:hover { background: var(--ca-bad) !important; color: #fff; }
    .rq-bar button:disabled { opacity: .45; cursor: not-allowed; }
    .rq { display: flex; justify-content: space-between; gap: 14px; align-items: center; flex-wrap: wrap; }
    .rq.pending { border-color: rgba(245,165,36,.45); }
    .rq.rejected, .rq.approved { opacity: .65; }
    .rq-main { display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: baseline; min-width: 0; flex: 1; }
    .rq-main b { font-size: 15.5px; }
    .rq-note { flex-basis: 100%; margin: 4px 0; color: #cfd3e0; font-size: 14px; overflow-wrap: anywhere; }
    .rq-side { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .bl-st { padding: 2px 9px; border-radius: 999px; font-size: 12px; font-weight: 700; }
    .bl-paid { color: var(--ca-ok); background: var(--ca-ok-soft); }
    .bl-pending { color: var(--ca-warn); background: var(--ca-warn-soft); }
    .bl-cancelled { color: var(--ca-muted); background: rgba(255,255,255,.06); }
</style>
<script>
    (function () {
        var boxes = Array.prototype.slice.call(document.querySelectorAll(".rq-chk")), all = document.getElementById("rqAll");
        if (!all) return;
        function upd() {
            var n = boxes.filter(function (b) { return b.checked; }).length;
            document.getElementById("rqN").textContent = n;
            document.getElementById("rqDelSel").disabled = n === 0;
            all.checked = n > 0 && n === boxes.length; all.indeterminate = n > 0 && n < boxes.length;
        }
        boxes.forEach(function (b) { b.addEventListener("change", upd); });
        all.addEventListener("change", function () { boxes.forEach(function (b) { b.checked = all.checked; }); upd(); });
        upd();
    })();
</script>
