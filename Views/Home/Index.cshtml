@model HomeModel
@{
    Layout = null;
    ViewData["TitleKey"] = "home.pageTitle";
    ViewData["Title"] = L["home.pageTitle"];

    // Mashq turlari: (controller, matn kaliti, savollar soni, daraja kaliti)
    var practice = new[]
    {
        ("Testforty", "nav.q20", 20, "hm.lvl1"),
        ("Testsixty", "nav.q40", 40, "hm.lvl2"),
        ("Testeighty", "nav.q80", 80, "hm.lvl3"),
        ("Testhundred", "nav.q100", 100, "hm.lvl4"),
        ("Testhundredsixty", "nav.q200", 200, "hm.lvl5"),
    };
}
<!DOCTYPE html>
<html lang="@L.HtmlLang" data-lang="@L.Lang" data-title-key="home.pageTitle" data-title-suffix=" — AVTOPRAVA_SAM" data-lang-reload>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>@ViewData["Title"] — AVTOPRAVA_SAM</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <partial name="_I18nScripts" />
    <style>
        body.hm { margin: 0; background: var(--ca-bg); color: var(--ca-text); font-family: var(--ca-font); -webkit-font-smoothing: antialiased; overflow-x: hidden; }
        .hm *, .hm *::before, .hm *::after { box-sizing: border-box; }
        .hm [hidden] { display: none !important; }
        .hm-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

        /* ── Ikki ustun: chapda Mavzular, o'ngda qolgan bo'limlar — bitta ekranga sig'adi ── */
        .hm-split {
            display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px;
            width: min(1600px, 100%); margin: 0 auto; padding: 16px clamp(14px, 2vw, 24px);
            height: calc(100dvh - var(--hm-header, 64px));
        }
        .hm-right { display: grid; grid-template-rows: auto minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.15fr); gap: 14px; min-height: 0; }
        .hm-block-title { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin: 0 0 8px; }
        .hm-block-title h2 { margin: 0; font-size: .95rem; font-weight: 800; color: #fff; }
        .hm-block-title span { font-size: .78rem; color: var(--ca-muted); }
        .hm-block { display: flex; flex-direction: column; min-height: 0; }

        /* Chap: Mavzular paneli */
        .hm-topics {
            position: relative; overflow: hidden; isolation: isolate; display: flex; flex-direction: column; min-height: 0;
            border-radius: 24px; padding: clamp(20px, 2.6vw, 34px);
            background: radial-gradient(120% 80% at 100% 0%, rgba(255,90,60,.20), transparent 55%),
                        linear-gradient(160deg, #2a0a12 0%, #170a10 45%, #0f1018 100%);
            border: 1px solid rgba(255,45,74,.32);
        }
        .hm-topics::after { content: ""; position: absolute; inset: auto -30% -45% -10%; height: 90%; background: radial-gradient(closest-side, rgba(255,45,74,.22), transparent); z-index: -1; }
        .hm-badge { align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: rgba(255,45,74,.16); color: #ff8a9b; font-size: .74rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
        .hm-badge i { width: 8px; height: 8px; border-radius: 50%; background: #ff2d4a; box-shadow: 0 0 0 4px rgba(255,45,74,.25); }
        .hm-topics h1 { margin: 14px 0 6px; font-size: clamp(2rem, 3.6vw, 3.1rem); font-weight: 900; line-height: 1.05; letter-spacing: -.02em; color: #fff; }
        .hm-topics-desc { margin: 0; max-width: 46ch; color: #d6d8e0; font-size: clamp(.9rem, 1.1vw, 1rem); line-height: 1.55; }
        .hm-car { flex: 1 1 auto; min-height: 0; overflow: hidden; display: flex; align-items: center; justify-content: center; margin: 6px 0; }
        .hm-car img { max-width: min(560px, 100%); max-height: 100%; width: auto; height: auto; object-fit: contain; filter: drop-shadow(0 26px 34px rgba(0,0,0,.55)); }
        .hm-chips { flex-shrink: 0; display: flex; flex-wrap: wrap; gap: 8px; overflow: hidden; }
        .hm-chip.cut { display: none; }
        .hm-chip {
            display: inline-flex; align-items: center; gap: 8px; max-width: 100%; padding: 7px 12px; border-radius: 10px; text-decoration: none;
            background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.10); color: #eceef4; font-size: .8rem; font-weight: 600; transition: all .15s;
        }
        .hm-chip span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .hm-chip b { color: var(--ca-muted); font-weight: 700; font-size: .72rem; }
        .hm-chip:hover { background: rgba(255,45,74,.16); border-color: rgba(255,45,74,.45); color: #fff; }
        .hm-topics-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-top: 16px; }
        .hm-cta {
            display: inline-flex; align-items: center; gap: 10px; padding: 13px 22px; border-radius: 14px; text-decoration: none;
            background: linear-gradient(135deg, #ff2d4a, #ff5a3c); color: #fff; font-weight: 800; font-size: .95rem; box-shadow: 0 10px 28px rgba(255,45,74,.35); transition: filter .15s, transform .15s;
        }
        .hm-cta:hover { filter: brightness(1.08); transform: translateY(-1px); color: #fff; }
        .hm-cta svg { width: 18px; height: 18px; }
        .hm-topics-count { color: var(--ca-muted); font-size: .85rem; }
        .hm-topics-count b { color: #fff; }

        /* O'ng: qidiruv */
        .hm-search { position: relative; }
        .hm-search-field { position: relative; display: block; }
        .hm-search-field > svg { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); width: 20px; height: 20px; color: var(--ca-faint); pointer-events: none; }
        .hm-search-input {
            width: 100%; height: 52px; padding: 0 112px 0 48px; border-radius: 16px; outline: none;
            border: 1px solid var(--ca-border-strong); background: var(--ca-surface); color: var(--ca-text);
            font: 600 .98rem var(--ca-font); transition: border-color .15s, box-shadow .15s;
        }
        .hm-search-input::placeholder { color: var(--ca-faint); font-weight: 500; }
        .hm-search-input::-webkit-search-cancel-button { display: none; }
        .hm-search-input:focus { border-color: var(--ca-brand); box-shadow: 0 0 0 4px var(--ca-brand-soft); }
        .hm-search-btn { position: absolute; right: 6px; top: 6px; height: 40px; padding: 0 18px; border: 0; border-radius: 11px; cursor: pointer; background: linear-gradient(135deg, #ff2d4a, #ff5a3c); color: #fff; font: 700 .86rem var(--ca-font); }
        .hm-search-btn:hover { filter: brightness(1.08); }
        .hm-suggest { position: absolute; left: 0; right: 0; top: 60px; z-index: 30; overflow: hidden; border-radius: 16px; background: var(--ca-bg-2); border: 1px solid var(--ca-border-strong); box-shadow: var(--ca-shadow-lg); }
        .hm-sg-item { display: grid; grid-template-columns: 48px minmax(0, 1fr); gap: 12px; align-items: center; padding: 10px 14px; text-decoration: none; border-bottom: 1px solid var(--ca-border); color: var(--ca-text); }
        .hm-sg-item:hover, .hm-sg-item.on { background: var(--ca-surface-2); }
        .hm-sg-thumb { width: 48px; height: 38px; border-radius: 8px; overflow: hidden; background: var(--ca-surface-2); display: grid; place-items: center; color: var(--ca-faint); }
        .hm-sg-thumb img { width: 100%; height: 100%; object-fit: cover; }
        .hm-sg-thumb svg { width: 18px; height: 18px; }
        .hm-sg-text { font-size: .9rem; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .hm-sg-text mark { background: rgba(255,45,74,.22); color: #fff; border-radius: 3px; padding: 0 2px; }
        .hm-sg-num { font-size: .72rem; font-weight: 700; color: var(--ca-faint); margin-right: 6px; }
        .hm-sg-foot { display: flex; justify-content: space-between; align-items: center; gap: 10px; padding: 12px 14px; color: var(--ca-brand); font-weight: 700; font-size: .86rem; text-decoration: none; }
        .hm-sg-foot:hover, .hm-sg-foot.on { background: var(--ca-surface-2); }
        .hm-sg-empty { padding: 16px 14px; color: var(--ca-muted); font-size: .9rem; }

        /* O'ng: mashq testlari */
        .hm-practice { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }
        .hm-tile {
            position: relative; display: flex; flex-direction: column; justify-content: flex-end; gap: 4px; padding: 14px; min-height: 0;
            border-radius: 16px; text-decoration: none; color: var(--ca-text); background: var(--ca-surface); border: 1px solid var(--ca-border);
            transition: transform .18s, border-color .18s, box-shadow .18s, background .18s;
        }
        .hm-tile:hover { transform: translateY(-3px); border-color: rgba(255,45,74,.45); box-shadow: var(--ca-shadow); background: linear-gradient(180deg, rgba(255,45,74,.08), var(--ca-surface)); color: var(--ca-text); }
        .hm-tile-num { font-size: clamp(1.6rem, 2.4vw, 2.3rem); font-weight: 900; line-height: 1; color: #fff; letter-spacing: -.03em; }
        .hm-tile-unit { font-size: .78rem; font-weight: 700; color: var(--ca-muted); }
        .hm-tile-lvl { margin-top: 6px; align-self: flex-start; font-size: .68rem; font-weight: 700; padding: 3px 8px; border-radius: 999px; background: var(--ca-brand-soft); color: #ff8a9b; white-space: nowrap; }
        .hm-tile-go { position: absolute; right: 10px; top: 10px; width: 28px; height: 28px; border-radius: 9px; display: grid; place-items: center; background: rgba(255,255,255,.04); color: var(--ca-muted); transition: all .18s; }
        .hm-tile-go svg { width: 15px; height: 15px; }
        .hm-tile:hover .hm-tile-go { background: var(--ca-brand); color: #fff; }

        /* O'ng: Biletlar va Marafon */
        .hm-modes { flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .hm-mode {
            display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 14px; padding: 16px 18px; min-height: 0;
            border-radius: 16px; text-decoration: none; color: var(--ca-text); background: var(--ca-surface); border: 1px solid var(--ca-border);
            transition: transform .18s, border-color .18s, box-shadow .18s;
        }
        .hm-mode:hover { transform: translateY(-3px); border-color: var(--ca-border-strong); box-shadow: var(--ca-shadow); color: var(--ca-text); }
        .hm-ic { width: 46px; height: 46px; border-radius: 14px; display: grid; place-items: center; }
        .hm-ic svg { width: 22px; height: 22px; }
        .hm-ic.blue { background: rgba(56,189,248,.14); color: #38bdf8; }
        .hm-ic.amber { background: rgba(245,165,36,.14); color: #fbbf24; }
        .hm-mode h3 { margin: 0 0 3px; font-size: 1.02rem; font-weight: 800; color: #fff; }
        .hm-mode p { margin: 0; color: var(--ca-muted); font-size: .8rem; line-height: 1.45; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        .hm-mode > svg { width: 18px; height: 18px; color: var(--ca-muted); transition: transform .18s, color .18s; }
        .hm-mode:hover > svg { transform: translateX(3px); color: var(--ca-brand); }

        /* O'ng: Real imtihon (eng oxirida) */
        .hm-exam {
            position: relative; overflow: hidden; isolation: isolate; min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 16px;
            padding: clamp(16px, 2vw, 24px); border-radius: 20px; text-decoration: none; color: var(--ca-text);
            background: linear-gradient(120deg, #2a0a12 0%, #160a10 50%, #0f1018 100%); border: 1px solid rgba(255,45,74,.35);
            transition: transform .2s, box-shadow .2s, border-color .2s;
        }
        .hm-exam::after { content: ""; position: absolute; inset: auto -20% -70% 35%; height: 140%; background: radial-gradient(closest-side, rgba(255,45,74,.26), transparent); z-index: -1; }
        .hm-exam:hover { transform: translateY(-3px); border-color: rgba(255,45,74,.7); box-shadow: 0 20px 50px rgba(255,45,74,.16); color: var(--ca-text); }
        .hm-exam h2 { margin: 10px 0 4px; font-size: clamp(1.3rem, 2.1vw, 1.8rem); font-weight: 900; color: #fff; letter-spacing: -.02em; }
        .hm-exam p { margin: 0 0 12px; color: #d6d8e0; font-size: .86rem; line-height: 1.5; }
        .hm-facts { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
        .hm-facts span { padding: 4px 10px; border-radius: 9px; background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.08); font-size: .76rem; font-weight: 600; color: #e9eaf0; }
        .hm-exam .hm-cta { padding: 10px 18px; font-size: .88rem; }
        .hm-trophy { width: clamp(84px, 9vw, 120px); aspect-ratio: 1; border-radius: 26px; display: grid; place-items: center; background: radial-gradient(circle at 30% 25%, rgba(255,122,69,.35), rgba(255,45,74,.12) 60%, transparent); border: 1px solid rgba(255,45,74,.35); color: #ffb199; transition: transform .3s; }
        .hm-trophy svg { width: 46%; height: 46%; }
        .hm-exam:hover .hm-trophy { transform: rotate(-6deg) scale(1.04); }

        /* Past ekranli kompyuterlar: ixchamroq */
        @@media (min-width: 901px) and (max-height: 820px) {
            .hm-topics h1 { font-size: 2rem; margin-top: 10px; }
            .hm-topics-desc { font-size: .88rem; }
            .hm-exam p { display: none; }
            .hm-exam h2 { margin: 6px 0 8px; }
            .hm-facts { margin-bottom: 8px; }
            .hm-topics-foot { margin-top: 10px; }
        }
        /* Juda past ekran (≤ 600px balandlik): sahifa oddiy aylantiriladi */
        @@media (min-width: 901px) and (max-height: 600px) {
            .hm-split { height: auto; }
            .hm-right { grid-template-rows: auto 170px 150px 190px; }
            .hm-topics { min-height: 520px; }
        }
        /* Planshet va telefon: ustunlar ustma-ust, sahifa aylantiriladi */
        @@media (max-width: 900px) {
            .hm-split { grid-template-columns: 1fr; height: auto; }
            .hm-right { grid-template-rows: none; display: flex; flex-direction: column; }
            .hm-car { min-height: 0; max-height: 200px; }
            .hm-car img { max-height: 200px; }
            .hm-practice { grid-template-columns: repeat(3, minmax(0, 1fr)); }
            .hm-tile { min-height: 104px; }
        }
        @@media (max-width: 560px) {
            .hm-search-input { padding-right: 16px; }
            .hm-search-btn { display: none; }
            .hm-practice { grid-template-columns: repeat(2, minmax(0, 1fr)); }
            .hm-practice .hm-tile:last-child { grid-column: 1 / -1; }
            .hm-modes { grid-template-columns: 1fr; }
            .hm-exam { grid-template-columns: 1fr; }
            .hm-trophy { display: none; }
        }
        @@media (prefers-reduced-motion: reduce) { .hm *, .hm *::after { transition: none !important; } }
    </style>
</head>
<body class="hm">
    <header class="ui-header" id="hmHeader">
        <div class="ui-header-inner">
            <a class="ui-brand" asp-controller="Home" asp-action="Index" aria-label="AVTOPRAVA_SAM">
                <img src="~/images/logo-96.png" alt="" />
                <span>AVTOPRAVA_SAM</span>
            </a>
            <div class="ui-header-actions">
                <a class="ui-home-link" asp-controller="Cabinet" asp-action="Index">
                    @Icons.Grid <span data-i18n="nav.myCabinet">@L["nav.myCabinet"]</span>
                </a>
                <partial name="_LangDropdown" />
                <partial name="_UserMenu" />
            </div>
        </div>
    </header>

    <main class="hm-split">
        <!-- Chap yarmi: Mavzular -->
        <section class="hm-topics" aria-labelledby="hmTopicsTitle">
            <span class="hm-badge"><i></i><span data-i18n="hm.topicsBadge">@L["hm.topicsBadge"]</span></span>
            <h1 id="hmTopicsTitle" data-i18n="nav.topics">@L["nav.topics"]</h1>
            <p class="hm-topics-desc" data-i18n="hm.topicsBannerDesc">@L["hm.topicsBannerDesc"]</p>

            <div class="hm-car"><img src="~/images/avprsm1 rrr.png" alt="" decoding="async" /></div>

            @if (Model.TopTopics.Count > 0)
            {
                <div class="hm-chips" aria-label="@L["hm.popularTopics"]">
                    @foreach (var (topic, count) in Model.TopTopics)
                    {
                        <a class="hm-chip" href="/Topic/Test?topic=@Uri.EscapeDataString(topic)" title="@L.Topic(topic)">
                            <span>@L.Topic(topic)</span><b>@count</b>
                        </a>
                    }
                </div>
            }

            <div class="hm-topics-foot">
                <a class="hm-cta" asp-controller="Topic" asp-action="Index">@Icons.Book <span data-i18n="hm.allTopics">@L["hm.allTopics"]</span></a>
                <span class="hm-topics-count">@L.F("hm.topicsFact1", ("n", Model.TopicCount)) · @L.F("hm.questionsInBank", ("n", Model.BankSize))</span>
            </div>
        </section>

        <!-- O'ng yarmi: qidiruv, mashq testlari, biletlar va marafon, real imtihon -->
        <div class="hm-right">
            <form class="hm-search" id="hmSearch" action="/Cabinet/Search" method="get" role="search" autocomplete="off">
                <h2 class="hm-sr" data-i18n="sq.title">@L["sq.title"]</h2>
                <label class="hm-search-field">
                    @Icons.Search
                    <input type="search" name="q" id="hmQ" class="hm-search-input" maxlength="200" spellcheck="false"
                           placeholder="@L["hm.searchPlaceholder"]" data-i18n-placeholder="hm.searchPlaceholder"
                           aria-label="@L["sq.title"]" aria-autocomplete="list" aria-controls="hmSuggest" aria-expanded="false" />
                </label>
                <button type="submit" class="hm-search-btn" data-i18n="hm.searchBtn">@L["hm.searchBtn"]</button>
                <div class="hm-suggest" id="hmSuggest" role="listbox" hidden></div>
            </form>

            <section class="hm-block" aria-labelledby="hmPracticeTitle">
                <div class="hm-block-title">
                    <h2 id="hmPracticeTitle" data-i18n="hm.practiceTitle">@L["hm.practiceTitle"]</h2>
                    <span data-i18n="hm.practiceShort">@L["hm.practiceShort"]</span>
                </div>
                <div class="hm-practice">
                    @foreach (var (ctrl, key, n, lvl) in practice)
                    {
                        <a class="hm-tile" asp-controller="@ctrl" asp-action="Index" aria-label="@L[key]">
                            <span class="hm-tile-go">@Icons.ArrowRight</span>
                            <span class="hm-tile-num">@n</span>
                            <span class="hm-tile-unit" data-i18n="hm.questions">@L["hm.questions"]</span>
                            <span class="hm-tile-lvl" data-i18n="@lvl">@L[lvl]</span>
                        </a>
                    }
                </div>
            </section>

            <section class="hm-block" aria-labelledby="hmModesTitle">
                <div class="hm-block-title">
                    <h2 id="hmModesTitle" data-i18n="hm.modesTitle">@L["hm.modesTitle"]</h2>
                </div>
                <div class="hm-modes">
                    <a class="hm-mode" asp-controller="Bilet" asp-action="Index">
                        <span class="hm-ic blue">@Icons.List</span>
                        <span>
                            <h3 data-i18n="nav.bilets">@L["nav.bilets"]</h3>
                            <p>@L.F("hm.biletsDesc", ("n", Model.BiletCount))</p>
                        </span>
                        @Icons.ArrowRight
                    </a>
                    <a class="hm-mode" asp-controller="TestAll" asp-action="Index">
                        <span class="hm-ic amber">@Icons.Flame</span>
                        <span>
                            <h3 data-i18n="nav.marathon">@L["nav.marathon"]</h3>
                            <p>@L.F("hm.marathonDesc", ("n", Model.BankSize))</p>
                        </span>
                        @Icons.ArrowRight
                    </a>
                </div>
            </section>

            <a class="hm-exam" asp-controller="Test" asp-action="Index">
                <div>
                    <span class="hm-badge"><i></i><span data-i18n="hm.examBadge">@L["hm.examBadge"]</span></span>
                    <h2 data-i18n="nav.real">@L["nav.real"]</h2>
                    <p data-i18n="hm.examDesc">@L["hm.examDesc"]</p>
                    <div class="hm-facts">
                        <span data-i18n="hm.examFact1">@L["hm.examFact1"]</span>
                        <span data-i18n="hm.examFact2">@L["hm.examFact2"]</span>
                    </div>
                    <span class="hm-cta">@Icons.Play <span data-i18n="hm.examStart">@L["hm.examStart"]</span></span>
                </div>
                <span class="hm-trophy" aria-hidden="true">@Icons.Trophy</span>
            </a>
        </div>
    </main>

    <script src="~/js/ui.js" asp-append-version="true"></script>
    <script>
    (function () {
        "use strict";

        // Sarlavha balandligi — ikki ustun ekranning qolgan qismini to'liq egallashi uchun
        var header = document.getElementById("hmHeader");
        function fit() { document.documentElement.style.setProperty("--hm-header", header.offsetHeight + "px"); }
        // Mavzu tugmalari: faqat butun qatorlar (kesilib qolgan tugma yashiriladi); baland ekranda 2 qator, pastida 1 qator
        var chips = Array.prototype.slice.call(document.querySelectorAll(".hm-chip"));
        function fitChips() {
            if (!chips.length) return;
            chips.forEach(function (c) { c.classList.remove("cut"); });
            if (window.innerWidth <= 900) return; // telefonda hammasi ko'rinadi
            var rows = window.innerHeight <= 820 ? 1 : 2;
            var tops = [];
            chips.forEach(function (c) { if (tops.indexOf(c.offsetTop) < 0) tops.push(c.offsetTop); });
            tops.sort(function (a, b) { return a - b; });
            var limit = tops[Math.min(rows, tops.length) - 1];
            chips.forEach(function (c) { if (c.offsetTop > limit) c.classList.add("cut"); });
        }
        function fitAll() { fit(); fitChips(); }
        fitAll();
        window.addEventListener("resize", fitAll);

        // ── Savol qidirish: yozish davomida eng mos 6 ta savol; Enter — barcha natijalar sahifasi ──
        var form = document.getElementById("hmSearch"), input = document.getElementById("hmQ"), box = document.getElementById("hmSuggest");
        var timer = null, seq = 0, active = -1;
        var ICON_IMG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"/></svg>';

        function esc(s) {
            return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) {
                return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c];
            });
        }
        function tokens(q) {
            var base = q.toLowerCase().replace(/['`´‘’ʻʼ]/g, "").split(/[^\p{L}\p{N}]+/u).filter(function (t) { return t.length >= 2; });
            var res = base.slice();
            base.forEach(function (t) { var c = I18n.toCyrillic ? I18n.toCyrillic(t).toLowerCase() : t; if (c && res.indexOf(c) < 0) res.push(c); });
            return res.sort(function (a, b) { return b.length - a.length; });
        }
        function highlight(text, toks) {
            text = String(text == null ? "" : text);
            if (!toks.length) return esc(text);
            var re;
            try {
                re = new RegExp(toks.map(function (t) {
                    return Array.from(t).map(function (ch) { return ch.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"); }).join("['`´‘’ʻʼ]?");
                }).join("|"), "giu");
            } catch (e) { return esc(text); }
            var out = "", last = 0, m;
            while ((m = re.exec(text)) !== null) {
                if (!m[0]) { re.lastIndex++; continue; }
                out += esc(text.slice(last, m.index)) + "<mark>" + esc(m[0]) + "</mark>";
                last = m.index + m[0].length;
            }
            return out + esc(text.slice(last));
        }
        function tooShort(q) { return q.replace(/['`´‘’ʻʼ\s]/g, "").length < 2 && !/^#?\d+$/.test(q); }
        function close() { box.hidden = true; active = -1; input.setAttribute("aria-expanded", "false"); }

        function suggest() {
            var q = input.value.trim();
            if (tooShort(q)) { close(); return; }
            var my = ++seq;
            fetch("/Cabinet/SearchQuestions?q=" + encodeURIComponent(q), { headers: { Accept: "application/json" }, cache: "no-store" })
                .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
                .then(function (d) {
                    if (my !== seq || input.value.trim() !== q) return;
                    var toks = tokens(q), items = (d.items || []).slice(0, 6), html = "";
                    if (!items.length) html = '<div class="hm-sg-empty">' + esc(I18n.t("sq.emptyTitle")) + "</div>";
                    items.forEach(function (it) {
                        var x = it.question;
                        var thumb = x.imageUrl ? '<img alt="" loading="lazy" src="/uploads/' + encodeURIComponent(x.imageUrl) + '?w=160">' : ICON_IMG;
                        html += '<a class="hm-sg-item" role="option" href="/Cabinet/Practice?ids=' + x.id + "&q=" + encodeURIComponent(q) + '">' +
                            '<span class="hm-sg-thumb">' + thumb + "</span>" +
                            '<span class="hm-sg-text"><span class="hm-sg-num">#' + x.id + "</span>" +
                            highlight(I18n.pick(x.questionUZ, x.questionRU, x.questionUZK), toks) + "</span></a>";
                    });
                    if (d.total > 0) {
                        html += '<a class="hm-sg-foot" href="/Cabinet/Search?q=' + encodeURIComponent(q) + '"><span>' +
                            esc(I18n.t("hm.allResults", { n: d.total })) + "</span><span>→</span></a>";
                    }
                    box.innerHTML = html;
                    box.hidden = false;
                    active = -1;
                    input.setAttribute("aria-expanded", "true");
                })
                .catch(function () { if (my === seq) close(); });
        }

        input.addEventListener("input", function () { clearTimeout(timer); timer = setTimeout(suggest, 200); });
        input.addEventListener("focus", function () { if (box.innerHTML && !tooShort(input.value.trim())) box.hidden = false; });
        input.addEventListener("keydown", function (e) {
            var links = box.hidden ? [] : box.querySelectorAll("a");
            if (e.key === "Escape") { close(); return; }
            if (!links.length) return;
            if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                e.preventDefault();
                active = (active + (e.key === "ArrowDown" ? 1 : -1) + links.length) % links.length;
                links.forEach(function (a, i) { a.classList.toggle("on", i === active); });
            } else if (e.key === "Enter" && active >= 0) {
                e.preventDefault();
                location.href = links[active].href;
            }
        });
        form.addEventListener("submit", function (e) { if (!input.value.trim()) { e.preventDefault(); input.focus(); } });
        document.addEventListener("click", function (e) { if (!form.contains(e.target)) close(); });
        document.addEventListener("keydown", function (e) {
            var tag = document.activeElement ? document.activeElement.tagName : "";
            if (e.key === "/" && !/INPUT|TEXTAREA|SELECT/.test(tag)) { e.preventDefault(); input.focus(); }
        });
        // Orqaga qaytilganda (brauzer keshi) eski ro'yxat ochiq qolmasin
        window.addEventListener("pageshow", function () { close(); });
    })();
    </script>
</body>
</html>
