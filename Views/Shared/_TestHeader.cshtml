@* Test sahifalarining yuqori paneli: logo · joriy test nomi + jonli progress · til menyusi · profil.
   Test mantiqiga tegmaydi — progressni sahifaning `questions` / `answers` o'zgaruvchilaridan faqat o'qiydi. *@
@{
    var tracked = TestTypes.Detect(Context.Request);

    // Test nomi uch tilda — til almashtirilganda sahifa qayta yuklanmaydi (data-i18n-pick)
    string NameIn(string lang)
    {
        if (tracked is not { } t) return Texts.Get(lang, "test.pageTitle");
        var name = Texts.Get(lang, "testType." + t.Type);
        if (string.IsNullOrWhiteSpace(t.Ref)) return name;
        return t.Type switch
        {
            TestTypes.Bilet => $"{name} №{t.Ref}",
            TestTypes.Topic => $"{name}: {Topics.Display(t.Ref, lang)}",
            _ => name,
        };
    }

    var testName = NameIn(L.Lang);
    var backUrl = User.IsInRole(Roles.SuperAdmin) ? "/Question/Index1" : "/";
}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
<link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />

<header class="ui-header ui-testbar">
    <div class="ui-header-inner">
        <a class="ui-brand" href="@backUrl" aria-label="AVTOPRAVA_SAM">
            <img src="~/images/logo-96.png" alt="" />
            <span>AVTOPRAVA_SAM</span>
        </a>

        <div class="ui-testbar-center">
            <span class="ui-testbar-live" aria-hidden="true"></span>
            <span class="ui-testbar-name" title="@testName" data-i18n-pick
                  data-uz="@NameIn(Lang.Uz)" data-ru="@NameIn(Lang.Ru)" data-uzk="@NameIn(Lang.Uzk)">@testName</span>
            <span class="ui-testbar-count" id="thCount" hidden aria-live="polite">
                <b id="thAnswered">0</b><span class="ui-testbar-sep">/</span><span id="thTotal">0</span>
            </span>
        </div>

        <div class="ui-header-actions">
            <partial name="_LangDropdown" />
            <partial name="_UserMenu" />
        </div>
    </div>

    @* Test boshqaruv paneli: sahifadagi asl "Chiqish" / "Yakunlash" tugmalarini bosadi (test mantig'i o'zgarmaydi) *@
    <div class="ui-testtools" id="testTools" hidden>
        <div class="ui-testtools-inner">
            <button type="button" class="ui-tt-btn" id="ttExit">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5" /><path d="m11 18-6-6 6-6" /></svg>
                <span id="ttExitLabel" data-i18n="test.exit">@L["test.exit"]</span>
            </button>

            <div class="ui-tt-mid" aria-live="polite">
                <span class="ui-tt-q" id="ttQ" hidden></span>
            </div>

            <button type="button" class="ui-tt-btn ghost" id="ttFull" title="@L["test.fullscreen"]" data-i18n-title="test.fullscreen" hidden>
                <svg class="ic-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3" /></svg>
                <svg class="ic-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3v3a2 2 0 0 1-2 2H3M21 8h-3a2 2 0 0 1-2-2V3M3 16h3a2 2 0 0 1 2 2v3M16 21v-3a2 2 0 0 1 2-2h3" /></svg>
                <span class="lbl-open" data-i18n="test.fullscreen">@L["test.fullscreen"]</span>
                <span class="lbl-close" data-i18n="test.fullscreenExit">@L["test.fullscreenExit"]</span>
            </button>

            <button type="button" class="ui-tt-btn primary" id="ttFinish">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                <span data-i18n="test.finish">@L["test.finish"]</span>
            </button>
        </div>
    </div>

    <div class="ui-testbar-progress" aria-hidden="true"><i id="thBar"></i></div>
</header>

<script src="~/js/ui.js" asp-append-version="true"></script>
<script>
    // Jonli progress: nechta savolga javob berilgani (test sahifasining o'z o'zgaruvchilaridan o'qiladi)
    (function () {
        var count = document.getElementById("thCount");
        var answered = document.getElementById("thAnswered");
        var total = document.getElementById("thTotal");
        var bar = document.getElementById("thBar");
        var last = "";
        function tick() {
            var q = null, a = null;
            try { q = typeof questions !== "undefined" ? questions : null; } catch (e) { /* hali e'lon qilinmagan */ }
            try { a = typeof answers !== "undefined" ? answers : null; } catch (e) { /* hali e'lon qilinmagan */ }
            if (!q || !q.length || !a) return;
            var n = q.filter(function (x) { return a[x.id] !== undefined; }).length;
            var key = n + "/" + q.length;
            if (key === last) return;
            last = key;
            answered.textContent = n;
            total.textContent = q.length;
            count.hidden = false;
            bar.style.width = (100 * n / q.length) + "%";
        }
        setInterval(tick, 300);

        // ── Test boshqaruv paneli (nav ostida): Chiqish · Savol N / M · To'liq ekran · Yakunlash ──
        // Tugmalar sahifadagi asl #exitBtn / #finishBtn ni bosadi — test mantig'i o'zgarmaydi; asl tugmalar yashiriladi.
        var tools = document.getElementById("testTools");
        var ttQ = document.getElementById("ttQ");
        function wireTools() {
            var exitO = document.getElementById("exitBtn"), finO = document.getElementById("finishBtn");
            if (!exitO && !finO) return;
            document.documentElement.classList.add("has-testtools");
            tools.hidden = false;

            var ttExit = document.getElementById("ttExit"), ttFin = document.getElementById("ttFinish");
            if (exitO) {
                // Qidiruvdan ochilgan savolda — "Qidiruvga qaytish"
                var key = exitO.getAttribute("data-i18n") === "sq.back" ? "test.backToSearch" : "test.exit";
                var lbl = document.getElementById("ttExitLabel");
                lbl.setAttribute("data-i18n", key);
                lbl.textContent = I18n.t(key);
                ttExit.addEventListener("click", function () { exitO.click(); });
            } else {
                ttExit.hidden = true;
            }
            if (finO) {
                ttFin.addEventListener("click", function () { finO.click(); });
                // Sahifa "Yakunlash"ni o'zi yashirsa (masalan, ko'rib chiqish rejimida) — panelda ham yashirinadi
                setInterval(function () { ttFin.hidden = finO.style.display === "none" || finO.disabled === true; }, 400);
            } else {
                ttFin.hidden = true;
            }

            var full = document.getElementById("ttFull");
            var root = document.documentElement;
            var enabled = document.fullscreenEnabled || document.webkitFullscreenEnabled;
            if (enabled) {
                full.hidden = false;
                full.addEventListener("click", function () {
                    var on = document.fullscreenElement || document.webkitFullscreenElement;
                    if (on) (document.exitFullscreen || document.webkitExitFullscreen).call(document);
                    else {
                        var req = root.requestFullscreen || root.webkitRequestFullscreen;
                        var p = req.call(root);
                        if (p && p.catch) p.catch(function () { });
                    }
                });
                var sync = function () { full.classList.toggle("on", !!(document.fullscreenElement || document.webkitFullscreenElement)); };
                document.addEventListener("fullscreenchange", sync);
                document.addEventListener("webkitfullscreenchange", sync);
            }
        }
        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", wireTools); else wireTools();

        // Joriy savol: "Savol 3 / 20"
        setInterval(function () {
            var q = null, idx = 0;
            try { q = typeof questions !== "undefined" ? questions : null; } catch (e) { /* hali e'lon qilinmagan */ }
            try { idx = typeof currentIndex !== "undefined" ? currentIndex : 0; } catch (e) { /* ... */ }
            if (!q || !q.length) return;
            ttQ.hidden = false;
            ttQ.textContent = I18n.t("test.qOf", { n: Math.min(idx + 1, q.length), total: q.length });
        }, 300);

        // Keyingi 2 ta savol rasmini oldindan yuklab qo'yamiz — savolga o'tganda rasm darhol chiqadi
        var preloaded = {};
        function preload() {
            var q = null, idx = 0;
            try { q = typeof questions !== "undefined" ? questions : null; } catch (e) { /* ... */ }
            try { idx = typeof currentIndex !== "undefined" ? currentIndex : 0; } catch (e) { /* ... */ }
            if (!q || !q.length) return;
            for (var i = idx; i <= idx + 2 && i < q.length; i++) {
                var url = q[i] && q[i].imageUrl ? "/uploads/" + q[i].imageUrl : null;
                if (url && !preloaded[url]) { preloaded[url] = true; new Image().src = url; }
            }
        }
        setInterval(preload, 700);

        // Brauzer tabi: "Real imtihon — AVTOPRAVA_SAM"
        var nameEl = document.querySelector(".ui-testbar-name");
        function setTitle() { document.title = nameEl.textContent + " — AVTOPRAVA_SAM"; }
        setTitle();
        document.addEventListener("DOMContentLoaded", setTitle); // i18n.js sarlavhani yangilagandan keyin
        document.addEventListener("i18n:change", setTitle);
    })();
</script>
