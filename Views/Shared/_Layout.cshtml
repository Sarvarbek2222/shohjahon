@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isHomePage = controller == "Home" && action == "Index";
    // Qaysi sahifalarda full navbar yashirin bo'ladi
    var hidePages = new List<(string controller, string action)>
    {
        ("Test", "Index"),
        ("Testforty", "Index"),
        ("Testsixty", "Index"),
        ("Testeighty","Index"),
        ("Testhundred","Index"),
        ("Testhundredsixty","Index"),
        ("Bilet","TestPage"),
        ("TestAll","Index"),
        ("Topic","Test")
    };

    var showFullNav = !hidePages.Any(p => p.controller == controller && p.action == action);
}

<!DOCTYPE html>
<html lang="@L.HtmlLang" data-lang="@L.Lang" data-title-key="@ViewData["TitleKey"]" data-title-suffix=" — AVTOPRAVA_SAM">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — AVTOPRAVA_SAM</title>

    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <partial name="_I18nScripts" />


    <style>

        /* 🔥 Til tugmalari */
        .top-lang .lang-btn {
            background-color: #111111;
            color: #f0f0f0;
            border: 1.5px solid #555555;
            padding: 4px 10px;
            margin: 0 2px;
            font-weight: 700;
            cursor: pointer;
            border-radius: 3px;
            transition: all 0.2s;
        }

            .top-lang .lang-btn:hover {
                background-color: #2a2a2a;
                color: #ffffff;
                border-color: #aaaaaa;
            }

            .top-lang .lang-btn.active {
                background-color: #ffffff !important;
                color: #000000 !important;
                border-color: #ffffff !important;
            }

        .custom-nav {
            background-color: #0a0a0a !important;
            border-bottom: 1px solid #222222;
        }

        .logo-img {
            border-radius: 80%;
            height: 50px;
            width: auto;
            max-height: 60px;
        }

        .logo-text {
            font-weight: 700;
            font-size: 1.3rem;
            letter-spacing: 1px;
            color: #ffffff;
            white-space: nowrap;
            text-shadow: 0 0 12px rgba(255,255,255,0.3);
        }

        body {
            background-color: #080808;
            color: #f0f0f0;
        }

            body a {
                color: white;
            }

            body .navbar,
            body .card,
            body .modal-content,
            body .dropdown-menu {
                background-color: #0a0a0a;
                color: #f0f0f0;
                border-color: #2a2a2a;
            }

            body .form-control {
                background-color: #111111;
                color: #f0f0f0;
                border: 1px solid #444;
            }

                body .form-control::placeholder {
                    color: #bbbbbb;
                }

            body .badge {
                background-color: #111111 !important;
            }

            /* Nav tugmalari — ko'k */
            body .btn-outline-primary {
                color: white;
                border-color:white;
                font-weight: 600;
                letter-spacing: 0.3px;
            }

                body .btn-outline-primary:hover {
                    background-color: white;
                    color: #000000;
                    box-shadow: 0 0 14px rgba(110, 198, 255, 0.45);
                }

            /* Real imtihon tugmasi — yashil, yorqin */
            body .btn-outline-success {
                color: #3dffaa;
                border-color: #3dffaa;
                font-weight: 700;
                letter-spacing: 0.3px;
            }

                body .btn-outline-success:hover {
                    background-color: #3dffaa;
                    color: #000000;
                    box-shadow: 0 0 18px rgba(61, 255, 170, 0.5);
                }

        nav {
            color: #f0f0f0;
        }

        .home-only {
            background-color: #0a0a0a !important;
        }

        .not-home {
            background-color: #0a0a0a !important;
        }

        /* ── FOOTER ── */
        footer {
            border-top: 1px solid #222222;
            padding: 40px 60px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background-color: #050505;
        }

        .footer-logo,
        .footer-logo:hover,
        .footer-logo:visited {
            font-family: 'Bebas Neue', sans-serif;
            font-size: 1.6rem;
            color: #ffffff !important;
            text-decoration: none;
            letter-spacing: 0.04em;
        }

            .footer-logo span {
                color: #ff4444 !important;
            }

        .footer-copy {
            font-size: 0.75rem;
            color: #888888;
            letter-spacing: 0.08em;
        }

        /* Nav tugmalari umumiy */
        .nav-btn {
            transition: all 0.2s ease;
        }



        /* mobil uchun */


        @@media (max-width: 768px) {
            footer

        {
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 24px 20px;
            gap: 10px;
        }

        .logo-text {
            font-size: 1rem;
        }

        .logo-img {
            height: 38px;
        }

        .top-lang {
            flex-wrap: wrap;
            justify-content: center;
        }

            .top-lang .lang-btn {
                padding: 3px 8px;
                font-size: 0.8rem;
            }

        .nav-btn {
            font-size: 0.78rem;
            padding: 5px 8px;
            margin: 3px 2px !important;
        }

        .navbar .container-fluid {
            flex-wrap: wrap;
            gap: 6px;
        }

        .d-flex.flex-row.justify-content-center {
            flex-wrap: wrap;
            justify-content: center;
        }

        }

        @@media (max-width: 400px) {
            .logo-text

        {
            font-size: 0.85rem;
        }

        .top-lang .lang-btn {
            padding: 2px 6px;
            font-size: 0.75rem;
        }

        }


    </style>
</head>
<body>

    <header class="ui-header">
        <div class="ui-header-inner">
            <a class="ui-brand" asp-controller="Home" asp-action="Index" aria-label="AVTOPRAVA_SAM">
                <img src="~/images/logo-96.png" alt="" />
                <span>AVTOPRAVA_SAM</span>
            </a>

            @* Test bo'limlari endi bosh sahifada — bu yerda faqat bosh sahifaga qaytish *@
            <div class="ui-header-actions">
                @if (showFullNav && !isHomePage && User.Identity?.IsAuthenticated == true)
                {
                    <a class="ui-home-link" asp-controller="Home" asp-action="Index">
                        @Icons.Home <span data-i18n="home.pageTitle">@L["home.pageTitle"]</span>
                    </a>
                }
                <partial name="_NotifyBell" />
                <partial name="_LangDropdown" />
                <partial name="_UserMenu" />
            </div>
        </div>
    </header>

    <div class="container mt-4">
        @RenderBody()
    </div>




    <!-- FOOTER -->
    <footer>
        <a href="#" class="footer-logo"><span> </span>AVTOPRAVA_SAM</a>
        <div class="footer-copy">© 2026 AVTOPRAVA_SAM — <span data-i18n="footer.rights">@L["footer.rights"]</span></div>
    </footer>

    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/ui.js" asp-append-version="true"></script>
    @*  <script src="~/js/site.js"></script> *@
</body>
</html>
